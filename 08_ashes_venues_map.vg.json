{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ashes Test venues across Australia and the United Kingdom. Two side-by-side maps with proportional symbols sized by matches hosted.",
  "background": "transparent",
  "config": {
    "font": "DM Sans",
    "view": {"stroke": null}
  },
  "hconcat": [
    {
      "title": {"text": "AUSTRALIA", "anchor": "start", "font": "DM Sans", "fontSize": 11, "fontWeight": 600, "color": "#0b1f33", "offset": 4, "subtitle": "6 Ashes venues", "subtitleFont": "Newsreader", "subtitleFontSize": 11, "subtitleColor": "#6a6f78", "subtitleFontStyle": "italic"},
      "width": 320,
      "height": 320,
      "projection": {"type": "mercator", "center": [134, -27], "scale": 480},
      "layer": [
        {
          "data": {
            "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
            "format": {"type": "topojson", "feature": "countries"}
          },
          "transform": [{"filter": "datum.id == 36"}],
          "mark": {"type": "geoshape", "fill": "#ece5d4", "stroke": "#2b3340", "strokeWidth": 0.6}
        },
        {
          "data": {"url": "data/ashes_venues.csv"},
          "transform": [{"filter": "datum.country == 'AUS'"}],
          "mark": {"type": "circle", "opacity": 0.85, "stroke": "#0b1f33", "strokeWidth": 1, "color": "#0e5e3a"},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "size": {
              "field": "matches",
              "type": "quantitative",
              "scale": {"range": [60, 1100]},
              "legend": {"title": "Matches hosted", "orient": "bottom", "direction": "horizontal", "symbolFillColor": "#0e5e3a"}
            },
            "tooltip": [
              {"field": "venue", "type": "nominal", "title": "Venue"},
              {"field": "city",  "type": "nominal", "title": "City"},
              {"field": "matches",  "type": "quantitative", "title": "Matches"},
              {"field": "capacity", "type": "quantitative", "title": "Capacity", "format": ","}
            ]
          }
        },
        {
          "data": {"url": "data/ashes_venues.csv"},
          "transform": [{"filter": "datum.country == 'AUS'"}],
          "mark": {"type": "text", "font": "DM Sans", "fontSize": 10, "fontWeight": 600, "color": "#0b1f33", "dy": -14},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "text": {"field": "venue"}
          }
        }
      ]
    },
    {
      "title": {"text": "ENGLAND", "anchor": "start", "font": "DM Sans", "fontSize": 11, "fontWeight": 600, "color": "#0b1f33", "offset": 4, "subtitle": "6 Ashes venues", "subtitleFont": "Newsreader", "subtitleFontSize": 11, "subtitleColor": "#6a6f78", "subtitleFontStyle": "italic"},
      "width": 220,
      "height": 320,
      "projection": {"type": "mercator", "center": [-1.5, 53.2], "scale": 2200},
      "layer": [
        {
          "data": {
            "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
            "format": {"type": "topojson", "feature": "countries"}
          },
          "transform": [{"filter": "datum.id == 826"}],
          "mark": {"type": "geoshape", "fill": "#ece5d4", "stroke": "#2b3340", "strokeWidth": 0.6}
        },
        {
          "data": {"url": "data/ashes_venues.csv"},
          "transform": [{"filter": "datum.country == 'ENG'"}],
          "mark": {"type": "circle", "opacity": 0.85, "stroke": "#0b1f33", "strokeWidth": 1, "color": "#1d3f6e"},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "size": {
              "field": "matches",
              "type": "quantitative",
              "scale": {"range": [60, 1100]},
              "legend": null
            },
            "tooltip": [
              {"field": "venue", "type": "nominal", "title": "Venue"},
              {"field": "city",  "type": "nominal", "title": "City"},
              {"field": "matches",  "type": "quantitative", "title": "Matches"},
              {"field": "capacity", "type": "quantitative", "title": "Capacity", "format": ","}
            ]
          }
        },
        {
          "data": {"url": "data/ashes_venues.csv"},
          "transform": [{"filter": "datum.country == 'ENG'"}],
          "mark": {"type": "text", "font": "DM Sans", "fontSize": 10, "fontWeight": 600, "color": "#0b1f33", "dy": -14},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "text": {"field": "venue"}
          }
        }
      ]
    }
  ],
  "resolve": {"scale": {"size": "shared"}}
}
