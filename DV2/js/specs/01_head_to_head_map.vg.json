{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australia head-to-head win % by decade. Use the slider to explore each decade.",
  "width": 820,
  "height": 460,
  "background": "transparent",
  "config": {
    "view": {"stroke": null},
    "font": "DM Sans",
    "legend": {
      "titleFont": "DM Sans", "labelFont": "DM Sans",
      "titleFontSize": 12, "labelFontSize": 11,
      "titleColor": "#2b3340", "labelColor": "#2b3340"
    }
  },
  "projection": {"type": "naturalEarth1", "scale": 155, "translate": [410, 245]},
  "params": [
    {
      "name": "decade",
      "value": 2000,
      "bind": {
        "input": "range",
        "min": 1970,
        "max": 2020,
        "step": 10,
        "name": "Decade:  "
      }
    }
  ],
  "layer": [
    {
      "description": "World background",
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {"type": "geoshape", "fill": "#ece5d4", "stroke": "#d6c69a", "strokeWidth": 0.4}
    },
    {
      "description": "Choropleth: fill by win% for selected decade",
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {"url": "data/head_to_head_decade.csv"},
            "key": "iso_num",
            "fields": ["country","win_1970","win_1980","win_1990","win_2000","win_2010","win_2020","m_1970","m_1980","m_1990","m_2000","m_2010","m_2020"]
          }
        },
        {"filter": "datum.country != null"},
        {"calculate": "datum['win_' + decade]", "as": "current_win"},
        {"filter": "datum.current_win != null && datum.current_win !== ''"}
      ],
      "mark": {"type": "geoshape", "stroke": "#0b1f33", "strokeWidth": 0.6},
      "encoding": {
        "color": {
          "field": "current_win",
          "type": "quantitative",
          "scale": {
            "domain": [30, 50, 70, 100],
            "range": ["#d6c69a", "#a3c08a", "#2d8a5e", "#074026"]
          },
          "legend": {"title": "AUS win %", "orient": "bottom-right", "gradientLength": 130, "format": ".0f"}
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Opponent"},
          {"field": "current_win", "type": "quantitative", "title": "AUS win %", "format": ".1f"}
        ]
      }
    },
    {
      "description": "Australia highlighted in gold",
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [{"filter": "datum.id == 36"}],
      "mark": {"type": "geoshape", "fill": "#c8a23d", "stroke": "#0b1f33", "strokeWidth": 0.8}
    },
    {
      "description": "Proportional symbols sized by matches played in that decade",
      "data": {"url": "data/head_to_head_decade.csv"},
      "transform": [
        {"calculate": "datum['m_' + decade]", "as": "current_matches"},
        {"calculate": "datum['win_' + decade]", "as": "current_win"},
        {"filter": "datum.current_matches != null && datum.current_matches !== '' && datum.current_matches > 0"}
      ],
      "mark": {"type": "circle", "opacity": 0.55, "stroke": "#0b1f33", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "current_matches",
          "type": "quantitative",
          "scale": {"range": [40, 1200]},
          "legend": {"title": "Matches played", "orient": "bottom-left", "symbolFillColor": "#0b1f33", "symbolStrokeColor": "#0b1f33"}
        },
        "color": {"value": "#0b1f33"},
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Opponent"},
          {"field": "current_matches", "type": "quantitative", "title": "Matches played"},
          {"field": "current_win", "type": "quantitative", "title": "AUS win %", "format": ".1f"}
        ]
      }
    }
  ]
}
