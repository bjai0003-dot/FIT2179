{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Cumulative ICC trophies won by nation, 1975-2025. Australia's gold line climbs faster and higher than any other country.",
  "width": 800,
  "height": 340,
  "background": "transparent",
  "config": {
    "font": "DM Sans",
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#2b3340", "titleColor": "#2b3340",
      "labelFont": "DM Sans", "titleFont": "DM Sans",
      "domainColor": "#2b3340", "gridColor": "rgba(11,31,51,0.07)", "tickColor": "#2b3340"
    },
    "legend": {
      "labelFont": "DM Sans", "titleFont": "DM Sans",
      "labelColor": "#2b3340", "titleColor": "#2b3340"
    }
  },
  "data": {"url": "data/icc_trophies.csv"},
  "transform": [
    {
      "filter": "datum.winner == 'Australia' || datum.winner == 'India' || datum.winner == 'West Indies' || datum.winner == 'England' || datum.winner == 'Pakistan'"
    },
    {
      "window": [{"op": "count", "as": "cumulative"}],
      "sort": [{"field": "year", "order": "ascending"}],
      "groupby": ["winner"]
    }
  ],
  "layer": [
    {
      "description": "Muted lines for other nations",
      "transform": [{"filter": "datum.winner != 'Australia'"}],
      "mark": {"type": "line", "interpolate": "step-after", "strokeWidth": 1.5, "opacity": 0.45},
      "encoding": {
        "x": {
          "field": "year", "type": "quantitative",
          "axis": {"title": null, "format": "d", "labelAngle": 0, "tickCount": 12}
        },
        "y": {
          "field": "cumulative", "type": "quantitative",
          "title": "ICC trophies won (cumulative)",
          "scale": {"domain": [0, 11]}
        },
        "color": {
          "field": "winner", "type": "nominal",
          "scale": {
            "domain": ["India", "West Indies", "England", "Pakistan"],
            "range": ["#1d3f6e", "#9b2a2a", "#2b3340", "#6a6f78"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "winner", "type": "nominal", "title": "Nation"},
          {"field": "tournament", "type": "nominal", "title": "Tournament"},
          {"field": "cumulative", "type": "quantitative", "title": "Total trophies"}
        ]
      }
    },
    {
      "description": "Australia area fill",
      "transform": [{"filter": "datum.winner == 'Australia'"}],
      "mark": {"type": "area", "interpolate": "step-after", "color": "#c8a23d", "opacity": 0.12},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "cumulative", "type": "quantitative"}
      }
    },
    {
      "description": "Australia line — thick gold",
      "transform": [{"filter": "datum.winner == 'Australia'"}],
      "mark": {"type": "line", "interpolate": "step-after", "strokeWidth": 3, "color": "#c8a23d"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "cumulative", "type": "quantitative"},
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "winner", "type": "nominal", "title": "Nation"},
          {"field": "tournament", "type": "nominal", "title": "Tournament"},
          {"field": "cumulative", "type": "quantitative", "title": "Total trophies"}
        ]
      }
    },
    {
      "description": "Direct labels at end of each line",
      "data": {"values": [
        {"year": 2024, "cumulative": 10.3, "label": "Australia — 10"},
        {"year": 2026, "cumulative": 5.3, "label": "India — 5"},
        {"year": 1981, "cumulative": 2.4, "label": "West Indies — 2"},
        {"year": 2023, "cumulative": 1.6, "label": "England — 2"},
        {"year": 2018, "cumulative": 2.4, "label": "Pakistan — 2"}
      ]},
      "mark": {"type": "text", "align": "left", "dx": 6, "font": "DM Sans", "fontSize": 11, "fontWeight": 600},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "cumulative", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "description": "Golden Era annotation",
      "data": {"values": [
        {"year": 2003, "cumulative": 9.6, "label": "Golden Era (1999-2009): 5 titles in 10 years"}
      ]},
      "mark": {"type": "text", "font": "Fraunces", "fontStyle": "italic", "fontSize": 11, "color": "#c8a23d", "fontWeight": 600, "align": "center"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "cumulative", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "description": "2023 Renaissance annotation",
      "data": {"values": [
        {"year": 2021, "cumulative": 8.4, "label": "2023: WTC + ODI WC won in the same year"}
      ]},
      "mark": {"type": "text", "font": "Fraunces", "fontStyle": "italic", "fontSize": 11, "color": "#0e5e3a", "fontWeight": 600, "align": "left", "dx": 6},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "cumulative", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
