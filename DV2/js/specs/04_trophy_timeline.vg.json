{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "ICC tournament timeline 1975-2025 with annotations highlighting Australia's golden era and key moments.",
  "width": 900,
  "height": 320,
  "background": "transparent",
  "config": {
    "font": "DM Sans",
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#2b3340", "titleColor": "#2b3340",
      "labelFont": "DM Sans", "titleFont": "DM Sans",
      "domainColor": "#2b3340", "gridColor": "transparent", "tickColor": "#2b3340"
    }
  },
  "data": {"url": "data/icc_trophies.csv"},
  "transform": [
    {"calculate": "datum.winner == 'Australia' ? 'Australia' : 'Other nation'", "as": "is_aus"}
  ],
  "layer": [
    {
      "description": "Stems (rules)",
      "mark": {"type": "rule", "color": "#2b3340", "strokeWidth": 1, "opacity": 0.3},
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {"domain": [1973, 2027]},
          "axis": {"title": null, "format": "d", "labelFontSize": 11, "tickCount": 11}
        },
        "y": {
          "field": "tournament",
          "type": "nominal",
          "sort": ["ODI World Cup", "Champions Trophy", "T20 World Cup", "WTC Final"],
          "title": null,
          "axis": {"labelFontSize": 12, "labelFontWeight": 500, "labelPadding": 8}
        },
        "y2": {"datum": 0}
      }
    },
    {
      "description": "Trophy dots",
      "mark": {"type": "point", "filled": true, "size": 280, "stroke": "#0b1f33", "strokeWidth": 1.2},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "tournament", "type": "nominal"},
        "color": {
          "field": "is_aus",
          "type": "nominal",
          "scale": {"domain": ["Australia", "Other nation"], "range": ["#c8a23d", "#d6c69a"]},
          "legend": {"title": "Trophy winner", "orient": "top", "labelFontSize": 12}
        },
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year"},
          {"field": "tournament", "type": "nominal", "title": "Tournament"},
          {"field": "winner", "type": "nominal", "title": "Winner"},
          {"field": "host", "type": "nominal", "title": "Host"},
          {"field": "result", "type": "nominal", "title": "Result"}
        ]
      }
    },
    {
      "description": "Year labels above AUS wins",
      "transform": [{"filter": "datum.winner == 'Australia'"}],
      "mark": {"type": "text", "dy": -18, "font": "Fraunces", "fontSize": 11, "fontWeight": 500, "color": "#0b1f33"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "tournament", "type": "nominal"},
        "text": {"field": "year", "format": "d"}
      }
    },
    {
      "description": "Golden era label",
      "data": {"values": [{"year": 2004, "tournament": "ODI World Cup", "label": "AUSTRALIA'S GOLDEN ERA"}]},
      "mark": {"type": "text", "dy": -75, "font": "DM Sans", "fontSize": 11, "fontWeight": 700, "color": "#c8a23d"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "tournament", "type": "nominal"},
        "text": {"field": "label"}
      }
    },
    {
      "description": "Golden era subtitle",
      "data": {"values": [{"year": 2004, "tournament": "ODI World Cup", "label": "5 trophies in 10 years — unmatched"}]},
      "mark": {"type": "text", "dy": -60, "font": "Fraunces", "fontSize": 11, "fontStyle": "italic", "color": "#0b1f33"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "tournament", "type": "nominal"},
        "text": {"field": "label"}
      }
    },
    {
      "description": "2023 renaissance annotation",
      "data": {"values": [{"year": 2023, "tournament": "WTC Final", "label": "↑ 2023: 2 ICC titles in one year"}]},
      "mark": {"type": "text", "dy": 28, "font": "Fraunces", "fontSize": 11, "fontStyle": "italic", "color": "#0e5e3a", "fontWeight": 600},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "tournament", "type": "nominal"},
        "text": {"field": "label"}
      }
    },
    {
      "description": "2021 T20 first win annotation",
      "data": {"values": [{"year": 2021, "tournament": "T20 World Cup", "label": "First T20 WC won →"}]},
      "mark": {"type": "text", "dy": -32, "dx": -65, "font": "Fraunces", "fontSize": 11, "fontStyle": "italic", "color": "#0e5e3a", "fontWeight": 600},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "tournament", "type": "nominal"},
        "text": {"field": "label"}
      }
    }
  ]
}
