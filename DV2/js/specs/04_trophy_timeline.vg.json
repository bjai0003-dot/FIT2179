{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "ICC tournament timeline 1975-2025. Gold dots = Australian wins. Annotations highlight the Golden Era cluster and key milestones.",
  "width": 820,
  "height": 280,
  "background": "transparent",
  "config": {
    "font": "DM Sans",
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#2b3340", "titleColor": "#2b3340",
      "labelFont": "DM Sans", "titleFont": "DM Sans",
      "domainColor": "#2b3340", "gridColor": "transparent", "tickColor": "#2b3340"
    },
    "legend": {
      "labelFont": "DM Sans", "titleFont": "DM Sans",
      "labelColor": "#2b3340", "titleColor": "#2b3340"
    }
  },
  "data": {"url": "data/icc_trophies.csv"},
  "transform": [
    {"calculate": "datum.winner == 'Australia' ? 'Australia' : 'Other nation'", "as": "is_aus"}
  ],
  "layer": [
    {
      "description": "Trophy dots",
      "mark": {"type": "point", "filled": true, "size": 260, "stroke": "#0b1f33", "strokeWidth": 1.2},
      "encoding": {
        "x": {
          "field": "year", "type": "quantitative",
          "scale": {"domain": [1973, 2027]},
          "axis": {"title": null, "format": "d", "labelFontSize": 11, "tickCount": 11, "grid": false}
        },
        "y": {
          "field": "tournament", "type": "nominal",
          "sort": ["ODI World Cup", "Champions Trophy", "T20 World Cup", "WTC Final"],
          "title": null,
          "axis": {"labelFontSize": 12, "labelFontWeight": 500, "labelPadding": 8, "labelLimit": 160}
        },
        "color": {
          "field": "is_aus", "type": "nominal",
          "scale": {"domain": ["Australia", "Other nation"], "range": ["#c8a23d", "#d6c69a"]},
          "legend": {"title": "Trophy winner", "orient": "top", "labelFontSize": 12}
        },
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year"},
          {"field": "tournament", "type": "nominal", "title": "Tournament"},
          {"field": "winner", "type": "nominal", "title": "Winner"},
          {"field": "host", "type": "nominal", "title": "Host"},
          {"field": "result", "type": "nominal", "title": "Result"}
        ]
      }
    },
    {
      "description": "Year labels above Australian wins only",
      "transform": [{"filter": "datum.winner == 'Australia'"}],
      "mark": {"type": "text", "dy": -17, "font": "Fraunces", "fontSize": 10, "fontWeight": 600, "color": "#0b1f33"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "tournament", "type": "nominal"},
        "text": {"field": "year", "format": "d"}
      }
    },
    {
      "description": "Golden Era header — T20 WC row at 2001, which is empty (T20 WC only exists from 2021)",
      "data": {"values": [{"year": 2001, "tournament": "T20 World Cup", "label": "AUSTRALIA'S GOLDEN ERA (1999-2009)"}]},
      "mark": {"type": "text", "font": "DM Sans", "fontSize": 11, "fontWeight": 700, "color": "#c8a23d", "align": "center"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "tournament", "type": "nominal"},
        "text": {"field": "label"}
      }
    },
    {
      "description": "Golden Era subtitle — same cell, small dy so it sits just below the header",
      "data": {"values": [{"year": 2001, "tournament": "T20 World Cup", "label": "5 trophies in 10 years — unmatched by any nation"}]},
      "mark": {"type": "text", "dy": 14, "font": "Fraunces", "fontStyle": "italic", "fontSize": 10, "color": "#2b3340", "align": "center"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "tournament", "type": "nominal"},
        "text": {"field": "label"}
      }
    },
    {
      "description": "First T20 WC annotation — WTC Final row at 2017, which is empty (WTC Final only from 2023)",
      "data": {"values": [{"year": 2017, "tournament": "WTC Final", "label": "First T20 World Cup won in 2021 ->"}]},
      "mark": {"type": "text", "font": "Fraunces", "fontStyle": "italic", "fontSize": 11, "color": "#0e5e3a", "fontWeight": 600, "align": "center"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "tournament", "type": "nominal"},
        "text": {"field": "label"}
      }
    }
  ]
}
