{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Big Bash League franchise map. All 8 BBL teams on an Australian map, coloured by team primary colour. Circle size encodes BBL titles won.",
  "width": 780,
  "height": 520,
  "background": "transparent",
  "config": {
    "font": "DM Sans",
    "view": {"stroke": null}
  },
  "projection": {"type": "mercator", "center": [134, -26], "scale": 920},
  "layer": [
    {
      "description": "Australia base map",
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [{"filter": "datum.id == 36"}],
      "mark": {"type": "geoshape", "fill": "#ece5d4", "stroke": "#2b3340", "strokeWidth": 0.7}
    },
    {
      "description": "Team circles — colour matches each team kit",
      "data": {"url": "data/bbl_franchises.csv"},
      "params": [{"name": "hoverTeam", "select": {"type": "point", "on": "mouseover", "clear": "mouseout"}}],
      "mark": {"type": "circle", "stroke": "#0b1f33", "strokeWidth": 1.4, "opacity": 0.88},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "titles",
          "type": "quantitative",
          "scale": {"domain": [0, 5], "range": [180, 2200]},
          "legend": {"title": "BBL titles won", "orient": "bottom-right", "symbolFillColor": "#0b1f33"}
        },
        "color": {
          "field": "colour",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "tooltip": [
          {"field": "team",     "type": "nominal", "title": "Franchise"},
          {"field": "city",     "type": "nominal", "title": "City"},
          {"field": "stadium",  "type": "nominal", "title": "Home ground"},
          {"field": "capacity", "type": "quantitative", "title": "Capacity", "format": ","},
          {"field": "titles",   "type": "quantitative", "title": "Titles won"}
        ]
      }
    },
    {
      "description": "Team short code labels above each circle",
      "data": {"url": "data/bbl_franchises.csv"},
      "mark": {"type": "text", "font": "DM Sans", "fontWeight": 700, "fontSize": 12, "color": "#0b1f33", "dy": -28},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "short"}
      }
    },
    {
      "description": "City name below each marker",
      "data": {"url": "data/bbl_franchises.csv"},
      "mark": {"type": "text", "font": "DM Sans", "fontWeight": 400, "fontSize": 10, "color": "#6a6f78", "dy": 28},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "city"}
      }
    }
  ]
}
