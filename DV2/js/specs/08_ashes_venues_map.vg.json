{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ashes Test venues across Australia and England on a single world map.",
  "width": 900,
  "height": 400,
  "background": "transparent",
  "config": {
    "font": "DM Sans",
    "view": {"stroke": null},
    "legend": {"titleFont": "DM Sans", "labelFont": "DM Sans", "titleFontSize": 12, "labelFontSize": 11, "titleColor": "#2b3340", "labelColor": "#2b3340"}
  },
  "projection": {"type": "equalEarth", "rotate": [-10, 0, 0], "scale": 200, "translate": [450, 220]},
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {"type": "geoshape", "fill": "#f4efe6", "stroke": "#d6c69a", "strokeWidth": 0.3}
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [{"filter": "datum.id == 36 || datum.id == 826"}],
      "mark": {"type": "geoshape", "fill": "#ece5d4", "stroke": "#2b3340", "strokeWidth": 0.8}
    },
    {
      "data": {"url": "data/ashes_venues.csv"},
      "mark": {"type": "circle", "opacity": 0.9, "stroke": "#0b1f33", "strokeWidth": 1.5},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "color": {
          "field": "country", "type": "nominal",
          "scale": {"domain": ["AUS", "ENG"], "range": ["#0e5e3a", "#1d3f6e"]},
          "legend": {"title": "Country", "orient": "top", "direction": "horizontal", "labelFontSize": 12}
        },
        "size": {
          "field": "matches", "type": "quantitative",
          "scale": {"range": [100, 1600]},
          "legend": {"title": "Matches hosted", "orient": "bottom-right"}
        },
        "tooltip": [
          {"field": "venue", "title": "Venue"},
          {"field": "city", "title": "City"},
          {"field": "country", "title": "Country"},
          {"field": "matches", "title": "Matches", "type": "quantitative"},
          {"field": "capacity", "title": "Capacity", "type": "quantitative", "format": ",d"}
        ]
      }
    },
    {
      "data": {"url": "data/ashes_venues.csv"},
      "mark": {"type": "text", "font": "DM Sans", "fontSize": 10, "fontWeight": 600, "dy": -18, "color": "#0b1f33"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "venue"}
      }
    }
  ]
}
