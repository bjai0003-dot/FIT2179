{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australia win rate by format — annotated horizontal bar chart.",
  "width": 350,
  "height": 220,
  "background": "transparent",
  "config": {
    "font": "DM Sans",
    "view": {"stroke": null},
    "axis": {"labelColor": "#2b3340", "titleColor": "#2b3340", "labelFont": "DM Sans", "titleFont": "DM Sans", "domainColor": "#2b3340", "gridColor": "rgba(11,31,51,0.06)", "tickColor": "#2b3340"}
  },
  "data": {"url": "data/win_by_format.csv"},
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 6, "height": 42},
      "encoding": {
        "y": {
          "field": "format", "type": "nominal",
          "sort": ["Test", "ODI", "T20I"],
          "axis": {"title": null, "labelFontSize": 14, "labelFontWeight": 600, "labelPadding": 12, "domainColor": "transparent", "tickColor": "transparent"}
        },
        "x": {
          "field": "win_pct", "type": "quantitative",
          "title": "Win percentage (%)",
          "scale": {"domain": [0, 100]}
        },
        "color": {
          "field": "format", "type": "nominal",
          "scale": {"domain": ["Test", "ODI", "T20I"], "range": ["#074026", "#0e5e3a", "#c8a23d"]},
          "legend": null
        },
        "tooltip": [
          {"field": "format", "title": "Format"},
          {"field": "win_pct", "title": "Win %", "type": "quantitative", "format": ".1f"},
          {"field": "matches", "title": "Matches", "type": "quantitative"},
          {"field": "avg_score", "title": "Avg score", "type": "quantitative"},
          {"field": "avg_wickets", "title": "Avg wickets", "type": "quantitative"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "right", "dx": -8, "fontSize": 18, "fontWeight": 700, "font": "Fraunces", "color": "#fff"},
      "encoding": {
        "y": {"field": "format", "type": "nominal", "sort": ["Test", "ODI", "T20I"]},
        "x": {"field": "win_pct", "type": "quantitative"},
        "text": {"field": "win_pct", "type": "quantitative", "format": ".1f"}
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 6, "fontSize": 11, "color": "#6a6f78"},
      "encoding": {
        "y": {"field": "format", "type": "nominal", "sort": ["Test", "ODI", "T20I"]},
        "x": {"field": "win_pct", "type": "quantitative"},
        "text": {"field": "matches", "type": "quantitative", "format": ",d"}
      }
    }
  ]
}
