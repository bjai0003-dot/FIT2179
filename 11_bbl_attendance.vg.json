{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "BBL per-game average attendance, BBL01-BBL14 (2011-2024). Annotated smooth area chart with COVID dip and peak season labelled.",
  "width": 980,
  "height": 300,
  "background": "transparent",
  "config": {
    "font": "DM Sans",
    "view": {"stroke": null},
    "axis": {"labelColor": "#2b3340", "titleColor": "#2b3340", "labelFont": "DM Sans", "titleFont": "DM Sans", "domainColor": "#2b3340", "gridColor": "rgba(11,31,51,0.07)", "tickColor": "#2b3340"}
  },
  "data": {"url": "data/bbl_attendance.csv"},
  "layer": [
    {
      "description": "COVID shading band",
      "data": {"values": [{"x1": "BBL10", "x2": "BBL11"}]},
      "mark": {"type": "rect", "color": "rgba(155,42,42,0.10)"},
      "encoding": {
        "x": {"field": "x1", "type": "ordinal"},
        "x2": {"field": "x2", "type": "ordinal"}
      }
    },
    {
      "description": "Filled area",
      "mark": {"type": "area", "interpolate": "monotone", "opacity": 0.15, "color": "#0e5e3a"},
      "encoding": {
        "x": {"field": "season", "type": "ordinal", "axis": {"title": null, "labelAngle": 0, "labelFontSize": 11}},
        "y": {"field": "avg_attendance", "type": "quantitative", "title": "Avg attendance per game", "axis": {"format": ","}},
        "tooltip": [
          {"field": "season",          "type": "nominal", "title": "Season"},
          {"field": "year",            "type": "quantitative", "title": "Year"},
          {"field": "avg_attendance",  "type": "quantitative", "title": "Avg attendance", "format": ","},
          {"field": "total_attendance","type": "quantitative", "title": "Total attendance", "format": ","},
          {"field": "note",            "type": "nominal", "title": "Note"}
        ]
      }
    },
    {
      "description": "Line",
      "mark": {"type": "line", "interpolate": "monotone", "color": "#0e5e3a", "strokeWidth": 2.5},
      "encoding": {
        "x": {"field": "season", "type": "ordinal"},
        "y": {"field": "avg_attendance", "type": "quantitative"}
      }
    },
    {
      "description": "Data points",
      "mark": {"type": "circle", "size": 80, "color": "#0e5e3a", "stroke": "#0b1f33", "strokeWidth": 1},
      "encoding": {
        "x": {"field": "season", "type": "ordinal"},
        "y": {"field": "avg_attendance", "type": "quantitative"}
      }
    },
    {
      "description": "Annotations: peak + COVID",
      "data": {
        "values": [
          {"season": "BBL07", "avg_attendance": 30114, "label": "Peak: 30,114 avg (2017)"},
          {"season": "BBL11", "avg_attendance": 9800,  "label": "← COVID floor: 9,800"},
          {"season": "BBL01", "avg_attendance": 17452, "label": "Launch: 17,452"}
        ]
      },
      "mark": {"type": "text", "font": "Fraunces", "fontStyle": "italic", "fontSize": 12, "color": "#0b1f33", "dy": -18, "fontWeight": 500},
      "encoding": {
        "x": {"field": "season", "type": "ordinal"},
        "y": {"field": "avg_attendance", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "description": "COVID text label in shaded band",
      "data": {"values": [{"season": "BBL10", "y": 3000, "label": "COVID-19"}]},
      "mark": {"type": "text", "font": "DM Sans", "fontWeight": 700, "fontSize": 10, "color": "#9b2a2a", "angle": 90},
      "encoding": {
        "x": {"field": "season", "type": "ordinal"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
